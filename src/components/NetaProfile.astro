---
import Layout from '../layouts/Layout.astro';
import { badgeMeta, allConstituencies, allNetas } from '../data/all';
import { districtSlug } from '../data/geo';
import { profiles } from '../data/profiles';
import { photos } from '../data/photos';
import type { Neta, RaiPoint, VerdictLine } from '../data/pilot';

interface Props {
  neta: Neta;
  base: string;      // '' for Maharashtra, '/gujarat' for Gujarat
  stateName: string; // 'Maharashtra' | 'Gujarat'
  homeLabel: string; // back link label
}

const { neta, base, stateName, homeLabel } = Astro.props;
const nameWords = neta.name.split(' ').filter(Boolean);
const initials = nameWords.length > 1
  ? (nameWords[0][0] + nameWords[nameWords.length - 1][0]).toUpperCase()
  : nameWords[0].slice(0, 2).toUpperCase();
const photo = photos[neta.slug];
// slug-hash se deterministic avatar-rang (bio generator wali tarz) — photo na hone par
const avatarHv = [...neta.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const avatarPalettes = [
  'linear-gradient(135deg, #1b2a41, #3d5a80)',
  'linear-gradient(135deg, #7c2d12, #c2410c)',
  'linear-gradient(135deg, #14532d, #16a34a)',
  'linear-gradient(135deg, #4c1d95, #7c3aed)',
  'linear-gradient(135deg, #831843, #be185d)',
  'linear-gradient(135deg, #0c4a6e, #0284c7)',
];
const avatarBg = avatarPalettes[avatarHv % avatarPalettes.length];
const verifiedCount = neta.works.filter(w => w.badge !== 'dawa').length;

// ---------- Bio + Janta ki Rai (researched profile ho to woh, warna record se auto) ----------
const extra = profiles[neta.slug];
const ok = (v?: string | null) => !!v && v.trim() !== '' && v.trim() !== '—' && v.trim().toLowerCase() !== 'n/a' && v.trim().toLowerCase() !== 'nil';
const myState = neta.state ?? 'Maharashtra';
const constInfo = allConstituencies.find(c => c.slug === neta.constituencySlug && (c.state ?? 'Maharashtra') === myState);
const cur = neta.tenures[neta.tenures.length - 1];
const isRS = neta.house === 'Rajya Sabha';
const reElected = neta.tenures.length > 1 || !!neta.prevAffidavit;
const b = neta.background;
const bgPending = (b.backgroundNote || '').startsWith('BACKGROUND_PENDING');
const bgNoteShown = bgPending ? b.backgroundNote.replace(/^BACKGROUND_PENDING:\s*/, '') : b.backgroundNote;

let bioParas: string[] = [];
let bioSourceNote = '';
if (extra?.bio?.length) {
  bioParas = extra.bio;
} else {
  // slug-hash se har neta ke liye jumla-banaavat ka alag mishran — tathya wahi (record se), andaaz alag
  const hv = [...neta.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const pick = (arr: string[], salt: number): string => arr[(hv + salt * 13) % arr.length];
  const postWord = neta.post === 'MLA' ? 'Vidhayak (MLA)' : 'Sansad (MP)';
  const houseWord = neta.post === 'MLA' ? 'Vidhan Sabha' : 'Lok Sabha';

  const p1: string[] = [];
  if (isRS) {
    p1.push(pick([
      `${neta.name} ${stateName} se Rajya Sabha ke sansad hain aur ${neta.party} se jude hain.`,
      `${neta.name} Rajya Sabha me ${stateName} ka pratinidhitva karte hain — ve ${neta.party} se jude hain.`,
      `${stateName} se Rajya Sabha ke liye chune gaye ${neta.name} ${neta.party} ke sansad hain.`,
    ], 1));
  } else {
    p1.push(pick([
      `${neta.name} ${stateName} ke ${neta.constituency} ${houseWord} kshetra se ${neta.party} ke ${postWord} hain.`,
      `${neta.constituency} ${houseWord} kshetra (${stateName}) ke pratinidhi hain ${neta.name} — ve ${neta.party} ke ${postWord} hain.`,
      `${neta.name} ${neta.party} ke ${postWord} hain aur ${stateName} ke ${neta.constituency} ${houseWord} kshetra ka pratinidhitva karte hain.`,
    ], 1));
  }
  if (constInfo?.district && constInfo.district !== neta.constituency && !isRS) p1.push(pick([
    `Ye kshetra ${constInfo.district} jile me aata hai.`,
    `Unka kshetra ${constInfo.district} jile ke antargat aata hai.`,
    `${neta.constituency} kshetra ${constInfo.district} jile me sthit hai.`,
  ], 2));
  if (cur) p1.push(pick([
    `Unka vartaman karyakaal ${cur.start} se ${cur.end} tak hai.`,
    `Vartaman karyakaal ${cur.start} se ${cur.end} tak ka hai.`,
    `Ve is samay ${cur.start}–${cur.end} wala karyakaal poora kar rahe hain.`,
  ], 3));
  if (neta.tenures.length > 1) p1.push(pick([
    `Ve ab tak kul ${neta.tenures.length} karyakaalon me jan-pratinidhi reh chuke hain — poori timeline neeche di gayi hai.`,
    `Jan-pratinidhi ke roop me ye unka karyakaal number ${neta.tenures.length} hai — purane karyakaalon ki timeline neeche di gayi hai.`,
    `Isse pehle bhi ve jan-pratinidhi reh chuke hain — kul ${neta.tenures.length} karyakaalon ka record neeche timeline me hai.`,
  ], 4));
  if (ok(neta.electionNote)) p1.push(neta.electionNote);
  bioParas.push(p1.join(' '));

  const p2: string[] = [];
  const factBits: string[] = [];
  if (ok(b.age)) factBits.push(`umar ${b.age} varsh`);
  if (ok(b.education)) factBits.push(`shiksha ${b.education}`);
  if (ok(b.assets)) factBits.push(`ghoshit kul sampatti ${b.assets}`);
  if (ok(b.liabilities)) factBits.push(`deyta ${b.liabilities}`);
  if (factBits.length) {
    const rot = factBits.length > 1 ? hv % factBits.length : 0;
    const ordered = [...factBits.slice(rot), ...factBits.slice(0, rot)];
    p2.push(pick([
      `Chunav halafname ke anusaar unki ${ordered.join(', ')} hai.`,
      `Unke chunav halafname me ye jankari darj hai: ${ordered.join(', ')}.`,
      `Halafname ke aankde batate hain — ${ordered.join(', ')}.`,
    ], 5));
  }
  if (bgPending) p2.push('Unka chunav halafnama abhi satyapit nahi ho saka hai (srot par page uplabdh nahi tha) — jankari poori hote hi yahan jod di jayegi.');
  else if (b.criminalCases === 0) p2.push(pick([
    'Halafname me unke khilaf koi aaparaadhik mamla darj nahi hai.',
    'Unke khilaf halafname me ek bhi aaparaadhik mamla darj nahi hai.',
    'Aaparaadhik mamlo ke hisaab se unka halafnama saaf hai — koi mamla darj nahi hai.',
  ], 6));
  else p2.push(pick([
    `Halafname me unke khilaf ${b.criminalCases} aaparaadhik mamle darj hain — ye aankda neeche halafnama section me srot ke saath diya gaya hai. Dhyaan dein: mamla darj hona dosh-siddhi (conviction) nahi hai.`,
    `Unke halafname me ${b.criminalCases} aaparaadhik mamle darj dikhai dete hain (vivaran neeche halafnama section me, srot sahit). Dhyaan dein: mamla darj hona dosh-siddhi (conviction) nahi hai.`,
  ], 6));
  if (neta.prevAffidavit) {
    const pv = neta.prevAffidavit;
    const curNum = parseInt((b.assets || '').replace(/[^0-9]/g, ''), 10) || 0;
    if (curNum && pv.assetsNum) {
      const pct = Math.round(((curNum - pv.assetsNum) / pv.assetsNum) * 100);
      const dir = pct > 2 ? `lagbhag ${pct}% zyada` : pct < -2 ? `lagbhag ${Math.abs(pct)}% kam` : 'lagbhag utni hi';
      p2.push(pick([
        `${pv.year} ke pichle halafname me unki ghoshit sampatti ${pv.assets} thi — is baar ${dir} hai. Do chunavon ki poori tulna neeche halafnama section me di gayi hai.`,
        `Sampatti ka badlav bhi darj hai: ${pv.year} me ${pv.assets}, is halafname me ${b.assets} — poori tulna neeche dekhein.`,
      ], 7));
    } else {
      p2.push(pick([
        `${pv.year} ke pichle halafname se tulna bhi is page par di gayi hai, taaki aap sampatti aur mamlo me badlav khud dekh sakein.`,
        `Unka ${pv.year} ka halafnama bhi record me hai — sampatti aur mamlo ki chunav-dar-chunav tulna neeche di gayi hai.`,
      ], 7));
    }
    if (typeof pv.criminalCases === 'number' && pv.criminalCases !== b.criminalCases && !bgPending) {
      p2.push(`${pv.year} ke halafname me darj mamle ${pv.criminalCases} the, is halafname me ${b.criminalCases} hain.`);
    }
  }
  if (p2.length) bioParas.push(p2.join(' '));

  const negRe = /NEGATIVE|FIR|aarop|janch|giraftari|bail|chargesheet|mamla|vivad|shikayat|PIL|DVAC|raid|chhaap/i;
  const posWorks = neta.works.filter(w => !negRe.test(w.title));
  const totalWorks = posWorks.length;
  if (totalWorks) {
    const cats = [...new Set(posWorks.map(w => w.category))].join(', ');
    const examples = posWorks
      .filter(w => w.title.length <= 130 && !negRe.test(w.title))
      .slice(0, 2)
      .map(w => w.title.replace(/\s*\([^)]*\)\s*$/, ''));
    if (examples.length === 2) {
      bioParas.push(pick([
        `AapkaNeta par unke karyakaal ke ${totalWorks} satyaapit kaam darj hain (${cats}) — har kaam ke saath uska srot diya gaya hai.`,
        `Unke karyakaal ke ${totalWorks} kaam AapkaNeta par srot sahit darj hain. Inme pramukh hain — "${examples[0]}" aur "${examples[1]}".`,
        `Is page par unke ${totalWorks} satyaapit kaam (${cats}) ka hisaab hai, jinme "${examples[0]}" jaisa kaam shamil hai — har entry ke saath srot diya gaya hai.`,
      ], 8));
    } else if (examples.length === 1) {
      bioParas.push(pick([
        `AapkaNeta par unke karyakaal ke ${totalWorks} satyaapit kaam darj ${totalWorks === 1 ? 'hai' : 'hain'} (${cats}) — har kaam ke saath uska srot diya gaya hai.`,
        `Unke karyakaal ke ${totalWorks} kaam AapkaNeta par srot sahit darj ${totalWorks === 1 ? 'hai' : 'hain'} — jaise "${examples[0]}".`,
      ], 8));
    } else {
      bioParas.push(`AapkaNeta par unke karyakaal ke ${totalWorks} satyaapit kaam darj ${totalWorks === 1 ? 'hai' : 'hain'} (${cats}) — har kaam ke saath uska srot diya gaya hai.`);
    }
  } else if (neta.works.length) {
    bioParas.push('AapkaNeta par unke karyakaal se juda record darj hai — poora vivaran neeche record wale section me srot sahit diya gaya hai.');
  } else {
    bioParas.push(pick([
      'AapkaNeta par unke kaam ka satyaapit record abhi jama kiya ja raha hai. Bina pakke saboot ke hum koi "kaam" list nahi karte — RTI aur samachar sroton se satyapan hote hi record yahan jud jayega.',
      'Abhi tak is page par unke karyakaal ka koi satyaapit kaam darj nahi ho paya hai. Hum bina pakke srot ke koi kaam nahi jodte — RTI aur samachar sroton se satyapit hote hi record yahan aayega.',
      'Unke kaam ka satyaapit record abhi taiyaar kiya ja raha hai. AapkaNeta sirf wahi kaam darj karta hai jiska pakka srot ho — isiliye kuch profiles shuruaat me khaali dikhte hain.',
    ], 8));
  }

  bioSourceNote = pick([
    'Ye parichay neta ke halafname, chunav record aur is page ke satyaapit kaam-record se banaya gaya hai.',
    'Upar ki jankari neta ke chunav halafname, chunav record aur AapkaNeta ke satyaapit kaam-record par aadhaarit hai.',
    'Ye parichay koi rai nahi hai — sirf halafname, chunav record aur satyaapit kaamon ke tathya hain.',
  ], 9);
}

const verdictLines: VerdictLine[] = extra?.verdict ?? [
  { label: `${cur?.start ?? ''} chunav`, detail: neta.electionNote },
  reElected
    ? { label: 'Dobara bharosa', detail: 'Pichle karyakaal ya pichle halafname ka record bhi maujud hai — kshetra ke matdataon ne unhe ek se zyada baar chuna hai.' }
    : { label: 'Is baar ka faisla', detail: 'Is chunav me kshetra ke matdataon ne unhe apna pratinidhi chuna — unke vartaman karyakaal ka poora record is page par rakha gaya hai.' },
];
const verdictNote = extra?.verdictNote ?? 'Chunav parinaam hi janta ki rai ka sabse pakka, napaa-tula saboot hota hai — isiliye hum survey, afwaah ya social-media ke shore ki jagah yahi aankde rakhte hain.';

const supportPts: RaiPoint[] = extra?.support ? [...extra.support] : [];
const critPts: RaiPoint[] = extra?.criticism ? [...extra.criticism] : [];
if (!extra) {
  if (reElected) supportPts.push({ text: 'Matdataon ne unhe dobara chuna hai — pichle karyakaal ke baad bhi kshetra ne unpar bharosa banaye rakha.', sourceLabel: 'Chunav record' });
  if (!bgPending && b.criminalCases === 0) supportPts.push({ text: 'Halafname me koi aaparaadhik mamla darj nahi — ye tathya unke sarvajanik record ka saaf paksh hai.', sourceLabel: 'ECI halafnama (myneta.info)', sourceUrl: b.mynetaUrl });
  if (verifiedCount > 0) supportPts.push({ text: `Is page par unke karyakaal ke ${verifiedCount} satyaapit kaam darj hain — har kaam srot ke saath janaacha gaya hai.`, sourceLabel: 'AapkaNeta record' });
  if (b.criminalCases > 0) critPts.push({ text: `Halafname me ${b.criminalCases} aaparaadhik mamle darj hain. Mamla darj hona dosh-siddhi nahi hai, lekin ye woh tathya hai jispar vipaksh aur media aksar sawal uthate hain — poora vivaran neeche halafnama section me hai.`, sourceLabel: 'ECI halafnama (myneta.info)', sourceUrl: b.mynetaUrl });
  if (neta.prevAffidavit) {
    const curNum = parseInt((b.assets || '').replace(/[^0-9]/g, ''), 10) || 0;
    const prevNum = neta.prevAffidavit.assetsNum || 0;
    if (curNum && prevNum) {
      const pct = Math.round(((curNum - prevNum) / prevNum) * 100);
      if (Math.abs(pct) >= 50) critPts.push({ text: `Do chunavon ke beech unki ghoshit sampatti me lagbhag ${pct}% ka badlav aaya (${neta.prevAffidavit.assets} se ${b.assets}) — poori tulna neeche halafnama-tulna section me di gayi hai.`, sourceLabel: 'Halafnama tulna (myneta.info)' });
    }
  }
  if (supportPts.length && !critPts.length) critPts.push({ text: 'Unke khilaf koi pramanit aalochna-bindu abhi hamare record me nahi hai — jaise hi kisi sthapit srot me koi bindu milega, woh srot ke saath yahan jod diya jayega.', sourceLabel: 'AapkaNeta record' });
  if (!supportPts.length && critPts.length) supportPts.push({ text: 'Matdataon ne is chunav me unhe vijayi banaya — chunav jeetna hi kshetra ke bharose ka sabse bada praman hai, isiliye yah bindu yahan darj hai.', sourceLabel: 'Chunav record' });
}
const supportHead = extra ? '👍 Samarthak kya kehte hain' : '👍 Paksh me jane wale tathya (record se)';
const critHead = extra ? '👎 Aalochak kya kehte hain' : '👎 Sawal uthne wale tathya (record se)';

// ---------- SEO: samriddh meta description + Person schema + jile ke anya neta (interlinking) ----------
const pageUrl = `https://aapkaneta.org${base}/neta/${neta.slug}/`;
const descParts: string[] = [`${neta.name} (${neta.partyShort}, ${neta.post} — ${neta.constituency}, ${stateName}) ne apne karyakaal me kya kaam kiya?`];
if (neta.works.length) descParts.push(`Karyakaal ke ${neta.works.length} satyaapit kaam darj ${neta.works.length === 1 ? 'hai' : 'hain'}.`);
if (ok(b.assets)) descParts.push(`Chunav halafnama: ghoshit sampatti ${b.assets}${b.criminalCases === 0 ? ', koi aaparaadhik mamla nahi' : `, ${b.criminalCases} aaparaadhik mamle darj`}.`);
descParts.push('Poora record — kaam ka hisaab, halafnama, sampatti aur janta ki rai — AapkaNeta par.');
const metaDescription = descParts.join(' ');
const personLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: neta.name,
  jobTitle: neta.post === 'MLA' ? 'Member of Legislative Assembly (MLA)' : neta.post === 'MP' ? 'Member of Parliament (MP)' : neta.post,
  affiliation: { '@type': 'Organization', name: neta.party },
  homeLocation: { '@type': 'Place', name: `${neta.constituency}, ${stateName}` },
  url: pageUrl,
  mainEntityOfPage: pageUrl,
};
if (photo) personLd.image = `https://aapkaneta.org${photo.file}`;
const myDistrict = constInfo?.district;
const districtConsts = myDistrict ? new Set(allConstituencies.filter(c => (c.state ?? 'Maharashtra') === myState && c.district === myDistrict).map(c => c.slug)) : new Set<string>();
const districtMates = myDistrict
  ? allNetas.filter(n => n.slug !== neta.slug && (n.state ?? 'Maharashtra') === myState && districtConsts.has(n.constituencySlug)).slice(0, 12)
  : [];
---

<Layout title={`${neta.name} — ${neta.constituency} ka hisaab`} description={metaDescription} jsonLd={personLd}>
  <style>
    .profile-hero { background: #fff; border-bottom: 1px solid var(--line); padding: 40px 0 30px; }
    .p-top { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
    .avatar-big {
      width: 96px; height: 96px; border-radius: 50%;
      color: #fff;
      display: grid; place-items: center; font-weight: 800; font-size: 34px; flex-shrink: 0;
    }
    .photo-wrap { flex-shrink: 0; width: 96px; text-align: center; }
    .photo-big { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--line); background: var(--paper); }
    .photo-credit { font-size: 10.5px; color: var(--ink-soft); margin-top: 4px; line-height: 1.35; }
    .photo-credit a { color: inherit; }
    .p-top h1 { font-size: 32px; line-height: 1.25; }
    .p-sub { color: var(--ink-soft); font-size: 17px; margin-top: 6px; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-top: 26px; }
    .stat { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 16px; text-align: center; }
    .stat b { font-size: 26px; display: block; }
    .stat span { font-size: 13.5px; color: var(--ink-soft); }
    .timeline { margin-top: 18px; display: flex; flex-direction: column; gap: 0; max-width: 680px; }
    .t-item { display: flex; gap: 16px; }
    .t-rail { display: flex; flex-direction: column; align-items: center; }
    .t-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); margin-top: 6px; flex-shrink: 0; }
    .t-line { width: 2px; flex: 1; background: var(--line); min-height: 30px; }
    .t-item:last-child .t-line { display: none; }
    .t-body { padding-bottom: 26px; }
    .t-body b { font-size: 17px; }
    .t-body p { color: var(--ink-soft); font-size: 15px; }
    .work { border-left: 4px solid var(--line); padding: 14px 18px; margin-bottom: 14px; background: #fff; border-radius: 0 12px 12px 0; }
    .work h3 { font-size: 17px; margin: 8px 0 4px; }
    .work p { font-size: 14.5px; color: var(--ink-soft); }
    .work .src { font-size: 13.5px; margin-top: 6px; }
    .empty {
      text-align: center; padding: 44px 24px; border: 2px dashed var(--line); border-radius: 14px;
      background: #fff; color: var(--ink-soft);
    }
    .empty p { max-width: 560px; margin: 10px auto 18px; }
    .fundbar { height: 14px; background: #e9e2d2; border-radius: 999px; overflow: hidden; margin: 10px 0 6px; }
    .fundbar i { display: block; height: 100%; background: linear-gradient(90deg, #f59e0b, #b45309); }
    .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
    .back { display: inline-block; margin-bottom: 18px; font-size: 15px; text-decoration: none; }
    .bg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .bg-item { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .bg-item span { display: block; font-size: 12.5px; color: var(--ink-soft); margin-bottom: 4px; }
    .bg-item b { font-size: 17px; }
    .bg-item b.warn { color: #b45309; }
    .bio-card p { font-size: 16px; color: #24344d; margin-bottom: 12px; }
    .bio-card p:last-child { margin-bottom: 0; }
    .verdict { background: linear-gradient(135deg, #1b2a41, #3d5a80); color: #fff; border-radius: 14px; padding: 22px 24px; margin-bottom: 14px; }
    .verdict h3 { font-size: 18px; margin-bottom: 12px; }
    .verdict h3 span { font-size: 13.5px; font-weight: 400; opacity: .85; }
    .vrow { display: flex; gap: 14px; flex-wrap: wrap; }
    .vbox { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.25); border-radius: 10px; padding: 12px 16px; flex: 1; min-width: 230px; }
    .vbox b { font-size: 19px; display: block; }
    .vbox span { font-size: 13.5px; opacity: .88; display: block; }
    .vbox .vsrc { font-size: 12px; margin-top: 6px; opacity: .8; }
    .vbox .vsrc a { color: #fcd9a8; }
    .verdict p { font-size: 14.5px; margin-top: 12px; opacity: .95; }
    .rai-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
    .rai { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; }
    .rai h3 { font-size: 17.5px; margin-bottom: 10px; }
    .rai ul { margin-left: 18px; }
    .rai li { font-size: 15px; color: #24344d; margin-bottom: 10px; }
    .rai li:last-child { margin-bottom: 0; }
    .rai .src { font-size: 12.5px; color: var(--ink-soft); }
    .rai-disclaimer { border: 1px dashed var(--accent); background: var(--accent-soft); border-radius: 12px; padding: 14px 18px; font-size: 14px; color: #5b4326; margin-top: 14px; }
    .rel-netas { margin-top: 8px; }
    .rel-note { font-size: 14.5px; color: var(--ink-soft); margin-bottom: 14px; }
    .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
    .rel-card { display: block; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; text-decoration: none; }
    .rel-card:hover { border-color: var(--accent); }
    .rel-card b { display: block; color: var(--ink); font-size: 15px; margin-bottom: 3px; }
    .rel-card span { font-size: 13px; color: var(--ink-soft); }
  </style>

  <div class="profile-hero">
    <div class="wrap">
      <a class="back" href={base ? `${base}/` : '/'}>← {homeLabel}</a>
      <div class="p-top">
        {photo ? (
          <div class="photo-wrap">
            <img class="photo-big" src={photo.file} alt={`${neta.name} ki tasveer`} width="96" height="96" loading="lazy" />
            <div class="photo-credit">Photo: <a href={photo.sourceUrl} rel="noopener">{photo.credit}</a> ({photo.license})</div>
          </div>
        ) : (
          <div class="avatar-big" style={`background:${avatarBg}`}>{initials}</div>
        )}
        <div>
          <h1>{neta.name}</h1>
          <div class="p-sub">{neta.post} • <a href={`${base}/kshetra/${neta.constituencySlug}/`}>{neta.constituency}</a> • {neta.party} • {stateName}</div>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><b>{verifiedCount}</b><span>verified kaam</span></div>
        <div class="stat"><b>{neta.tenures.length}</b><span>karyakaal (tenure)</span></div>
        <div class="stat"><b>{neta.fund?.utilizationPct != null ? neta.fund.utilizationPct + '%' : '—'}</b><span>fund utilization</span></div>
        <div class="stat"><b>{neta.works.filter(w=>w.badge==='rti').length}</b><span>RTI verified</span></div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <h2 class="section-title">Neta ke baare me</h2>
    <div class="card bio-card">
      {bioParas.map(p => <p>{p}</p>)}
      {!extra && bioSourceNote && <p style="font-size:13.5px;color:var(--ink-soft)">{bioSourceNote}</p>}
    </div>

    <h2 class="section-title">Janta ki rai — log kya kehte hain</h2>
    <div class="verdict">
      <h3>🗳️ Chunav me janta ka faisla <span>(sabse pakka saboot — ECI parinaam)</span></h3>
      <div class="vrow">
        {verdictLines.map(v => (
          <div class="vbox">
            <b>{v.label}</b>
            <span>{v.detail}</span>
            {v.sourceLabel && <div class="vsrc">Srot: {v.sourceUrl ? <a href={v.sourceUrl} rel="noopener">{v.sourceLabel}</a> : v.sourceLabel}</div>}
          </div>
        ))}
      </div>
      <p>{verdictNote}</p>
    </div>
    {(supportPts.length > 0 || critPts.length > 0) && (
      <div class="rai-grid">
        {supportPts.length > 0 && (
          <div class="rai">
            <h3 style="color:var(--green)">{supportHead}</h3>
            <ul>
              {supportPts.map(pt => (
                <li>{pt.head && <b>{pt.head}: </b>}{pt.text} <span class="src">({pt.sourceUrl ? <a href={pt.sourceUrl} rel="noopener">{pt.sourceLabel}</a> : pt.sourceLabel})</span></li>
              ))}
            </ul>
          </div>
        )}
        {critPts.length > 0 && (
          <div class="rai">
            <h3 style="color:#b91c1c">{critHead}</h3>
            <ul>
              {critPts.map(pt => (
                <li>{pt.head && <b>{pt.head}: </b>}{pt.text} <span class="src">({pt.sourceUrl ? <a href={pt.sourceUrl} rel="noopener">{pt.sourceLabel}</a> : pt.sourceLabel})</span></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
    <div class="rai-disclaimer">⚠️ <b>Note:</b> Ye section AapkaNeta ki apni rai nahi hai. Ye chunav parinaamon (ECI), halafname aur sthapit media reporting ka sankalan hai — har bindu ke saath uska srot diya gaya hai. Koi bindu galat ya ekpakshiya lage to <a href={`/correction/?neta=${encodeURIComponent(neta.name)}`}>correction bhejein</a>, hum srot ke saath sudhaar karenge.</div>

    <h2 class="section-title">Karyakaal timeline</h2>
    <div class="card">
      <div class="timeline">
        {neta.tenures.map(t => (
          <div class="t-item">
            <div class="t-rail"><span class="t-dot"></span><span class="t-line"></span></div>
            <div class="t-body">
              <b>{t.post} — {t.constituency}</b>
              <p>{t.party} • {t.start} – {t.end}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <h2 class="section-title">Kaam ka hisaab</h2>
    {neta.works.length === 0 ? (
      <div class="empty">
        <div style="font-size:40px">🗂️</div>
        <h3 style="color:var(--ink);margin-top:8px">Record jama kiya ja raha hai</h3>
        <p>Is neta ke kaam ka satyaapit record abhi taiyaar ho raha hai. Bina saboot ke hum koi "kaam" list nahi karte — yehi AapkaNeta ka usool hai. RTI ke jawab aate hi yahan dikhega.</p>
        <div class="cta-row" style="justify-content:center">
          <a class="btn" href="/rti/">RTI Drive me hissa lein</a>
          <a class="btn-ghost" href="/methodology/">Hamari methodology</a>
        </div>
      </div>
    ) : (
      neta.works.map(w => {
        const b = badgeMeta[w.badge];
        return (
          <div class="work">
            <span class="badge" style={`color:${b.color}`}>{b.label}</span>
            <span style="font-size:13px;color:var(--ink-soft);margin-left:8px">{w.category}{w.period ? ` • ${w.period}` : ''}{w.date ? ` • ${w.date}` : ''}</span>
            <h3>{w.title}</h3>
            {w.note && <p>{w.note}</p>}
            <div class="src">Source: {w.sourceUrl ? <a href={w.sourceUrl} rel="noopener">{w.sourceLabel}</a> : w.sourceLabel}</div>
          </div>
        );
      })
    )}

    <h2 class="section-title">Fund utilization</h2>
    <div class="card">
      <b>{neta.fund?.scheme}</b>
      {neta.fund?.utilizationPct != null ? (
        <div>
          <div class="fundbar"><i style={`width:${neta.fund.utilizationPct}%`}></i></div>
          <p style="font-size:15px">{neta.fund.allocated} me se {neta.fund.utilized} kharch ({neta.fund.utilizationPct}%)</p>
        </div>
      ) : (
        <p style="color:var(--ink-soft);font-size:15px;margin-top:8px">{neta.fund?.note}</p>
      )}
      <p style="font-size:13.5px;color:var(--ink-soft);margin-top:10px">Record ke anusaar — daawa nahi, dastavez.</p>
    </div>

    <h2 class="section-title">Halafnama <span style="font-size:15px;font-weight:400;color:var(--ink-soft)">(ECI affidavit, myneta.info)</span></h2>
    <div class="card">
      {bgNoteShown ? (
        <p style="font-size:15.5px;color:var(--ink-soft)">{bgNoteShown}</p>
      ) : (
        <>
          <div class="bg-grid">
            <div class="bg-item"><span>Umar</span><b>{neta.background.age} varsh</b></div>
            <div class="bg-item"><span>Shiksha</span><b>{neta.background.education}</b></div>
            <div class="bg-item"><span>Aaparaadhik mamle</span><b class={neta.background.criminalCases > 0 ? 'warn' : ''}>{bgPending ? '—' : neta.background.criminalCases}</b></div>
            <div class="bg-item"><span>Kul sampatti</span><b>{neta.background.assets}</b></div>
            <div class="bg-item"><span>Deyta (liabilities)</span><b>{neta.background.liabilities}</b></div>
          </div>
          <p style="font-size:14px;color:var(--ink-soft);margin-top:8px">
            Ye aankde neta ke chunav halafname se hain. Poora record: <a href={neta.background.mynetaUrl} rel="noopener">myneta.info par dekhein</a> • <a href="https://affidavit.eci.gov.in/" rel="noopener">ECI Affidavit Portal</a>
          </p>
        </>
      )}
      <p style="font-size:15.5px;margin-top:14px">{neta.electionNote}</p>
    </div>

    <h2 class="section-title">Halafnama{neta.prevAffidavit ? `: ${neta.prevAffidavit.year} vs ${(neta.state === 'Kerala' || neta.state === 'Assam' || neta.state === 'Tamil Nadu') ? '2026' : neta.state === 'Gujarat' || neta.state === 'Goa' || neta.state === 'Manipur' || neta.state === 'Punjab' ? '2022' : neta.state === 'Rajasthan' || neta.state === 'Mizoram' || neta.state === 'Nagaland' || neta.state === 'Tripura' || neta.state === 'Telangana' ? '2023' : neta.state === 'Uttar Pradesh' ? '2022' : neta.state === 'Madhya Pradesh' ? '2023' : neta.state === 'Bihar' ? '2025' : neta.state === 'Karnataka' ? '2023' : '2024'}` : (neta.state === 'Uttar Pradesh' || neta.state === 'Madhya Pradesh' ? '' : `: ${(neta.state === 'Kerala' || neta.state === 'Assam' || neta.state === 'Tamil Nadu') ? '2021 vs 2026' : neta.state === 'Bihar' ? '2020 vs 2025' : neta.state === 'Gujarat' || neta.state === 'Goa' || neta.state === 'Manipur' || neta.state === 'Punjab' ? '2017 vs 2022' : neta.state === 'Rajasthan' || neta.state === 'Mizoram' || neta.state === 'Nagaland' || neta.state === 'Tripura' || neta.state === 'Telangana' || neta.state === 'Karnataka' ? '2018 vs 2023' : '2019 vs 2024'}`)}</h2>
    <div class="card">
      {neta.prevAffidavit ? (
        <>
          <p style="font-size:14.5px;color:var(--ink-soft);margin-bottom:14px">Dono chunavon ke halafnamon ke aankde — aap khud tulna karein.</p>
          <div class="bg-grid">
            <div class="bg-item"><span>Kul sampatti ({neta.prevAffidavit.year})</span><b>{neta.prevAffidavit.assets}</b></div>
            <div class="bg-item"><span>Kul sampatti ({(neta.state === 'Kerala' || neta.state === 'Assam' || neta.state === 'Tamil Nadu') ? '2026' : neta.state === 'Gujarat' || neta.state === 'Goa' || neta.state === 'Manipur' || neta.state === 'Punjab' ? '2022' : neta.state === 'Rajasthan' || neta.state === 'Mizoram' || neta.state === 'Nagaland' || neta.state === 'Telangana' ? '2023' : neta.state === 'Madhya Pradesh' ? '2023' : neta.state === 'Bihar' ? '2025' : '2024'})</span><b>{neta.background.assets}</b></div>
            {neta.prevAffidavit.assetsNum > 0 && (
              <div class="bg-item"><span>5 saal me badlav</span><b>{
                (() => {
                  const cur = parseInt((neta.background.assets || '').replace(/[^0-9]/g, ''), 10) || 0;
                  const prev = neta.prevAffidavit!.assetsNum;
                  if (!cur || !prev) return '—';
                  const pct = Math.round(((cur - prev) / prev) * 100);
                  return (pct >= 0 ? '+' : '') + pct + '%';
                })()
              }</b></div>
            )}
            <div class="bg-item"><span>Aaparaadhik mamle ({neta.prevAffidavit.year})</span><b>{neta.prevAffidavit.criminalCases}</b></div>
            <div class="bg-item"><span>Aaparaadhik mamle ({(neta.state === 'Kerala' || neta.state === 'Assam' || neta.state === 'Tamil Nadu') ? '2026' : neta.state === 'Gujarat' || neta.state === 'Goa' || neta.state === 'Manipur' || neta.state === 'Punjab' ? '2022' : neta.state === 'Rajasthan' || neta.state === 'Mizoram' || neta.state === 'Nagaland' || neta.state === 'Tripura' || neta.state === 'Telangana' ? '2023' : neta.state === 'Uttar Pradesh' ? '2022' : neta.state === 'Madhya Pradesh' ? '2023' : neta.state === 'Bihar' ? '2025' : '2024'})</span><b class={neta.background.criminalCases > 0 ? 'warn' : ''}>{bgPending ? '—' : neta.background.criminalCases}</b></div>
            <div class="bg-item"><span>Shiksha ({neta.prevAffidavit.year})</span><b>{neta.prevAffidavit.education}</b></div>
            <div class="bg-item"><span>Umar ({neta.prevAffidavit.year} → {(neta.state === 'Kerala' || neta.state === 'Assam' || neta.state === 'Tamil Nadu') ? '2026' : neta.state === 'Gujarat' || neta.state === 'Goa' || neta.state === 'Manipur' || neta.state === 'Punjab' ? '2022' : neta.state === 'Rajasthan' || neta.state === 'Mizoram' || neta.state === 'Nagaland' || neta.state === 'Tripura' || neta.state === 'Telangana' ? '2023' : neta.state === 'Uttar Pradesh' ? '2022' : neta.state === 'Madhya Pradesh' ? '2023' : neta.state === 'Bihar' ? '2025' : '2024'})</span><b>{neta.prevAffidavit.age} → {neta.background.age} varsh</b></div>
          </div>
          <p style="font-size:14px;color:var(--ink-soft);margin-top:8px">
            {neta.prevAffidavit.year} ka poora halafnama: <a href={neta.prevAffidavit.mynetaUrl} rel="noopener">myneta.info par dekhein</a>
          </p>
        </>
      ) : (
        <p style="font-size:15px;color:var(--ink-soft)">Pichhle chunav ka halafnama uplabdh nahi — us samay ye ummidwar nahi the, ya record nahi mila.</p>
      )}
    </div>

    {districtMates.length > 0 && (
      <div class="rel-netas">
        <h2 class="section-title">{myDistrict} jile ke anya neta</h2>
        <p class="rel-note">Isi jile ke anya jan-pratinidhiyon ka record bhi dekhein — <a href={`${base}/jila/${districtSlug(myDistrict!)}/`}>{myDistrict} jila page</a> par poori suchi hai.</p>
        <div class="rel-grid">
          {districtMates.map(m => (
            <a class="rel-card" href={`${base}/neta/${m.slug}/`}>
              <b>{m.name}</b>
              <span>{m.post} • {m.constituency} • {m.partyShort}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="cta-row" style="margin: 36px 0 8px">
      <a class="btn" href={`/rti/?seat=${neta.constituencySlug}${stateName && stateName !== 'Maharashtra' ? `&state=${stateName}` : ''}`}>Is neta par RTI lagao</a>
      <a class="btn-ghost" href={`/correction/?neta=${encodeURIComponent(neta.name)}`}>Galat info? Correction bhejo</a>
    </div>
  </div>
</Layout>
