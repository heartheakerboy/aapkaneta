---
interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description = 'Har neta ka hisaab, har nagrik ke haath. RTI-verified neta work tracker.', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://aapkaneta.org').href;
---

<!doctype html>
<html lang="hi">
  <head>
    <script>if (location.hostname === 'aapkaneta.pages.dev') { location.replace('https://aapkaneta.org' + location.pathname + location.search + location.hash); }</script>
    <meta name="google-site-verification" content="9cuKBHGFb2Q3_b1cPP7h8Ie0jbsAc9G_VUm3EB-8dB8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9VCCZD5DMP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9VCCZD5DMP');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | AapkaNeta.org</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AapkaNeta.org" />
    <meta property="og:title" content={`${title} | AapkaNeta.org`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | AapkaNeta.org`} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        --ink: #1b2a41;
        --ink-soft: #3d4f6b;
        --paper: #faf8f2;
        --card: #ffffff;
        --line: #e6e0d2;
        --accent: #b45309;
        --accent-soft: #fef3e2;
        --green: #166534;
        --blue: #1d4ed8;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: "Noto Sans Devanagari", "Mukta", system-ui, -apple-system, "Segoe UI", sans-serif;
        background: var(--paper);
        color: var(--ink);
        line-height: 1.65;
      }
      html, body { overflow-x: clip; }
      a { color: var(--accent); }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site {
        background: var(--ink);
        color: #fff;
        position: sticky; top: 0; z-index: 50;
        box-shadow: 0 2px 12px rgba(0,0,0,.18);
      }
      .bar { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; max-width: 1080px; margin: 0 auto; }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; }
      .brand-mark {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg, #f59e0b, #b45309);
        display: grid; place-items: center; font-weight: 800; font-size: 20px; color: #fff;
      }
      .brand b { font-size: 20px; letter-spacing: .2px; }
      .brand small { display: block; font-size: 11px; color: #cbd5e1; font-weight: 400; line-height: 1.2; }
      nav.site { display: flex; gap: 4px; }
      nav.site a {
        color: #e2e8f0; text-decoration: none; font-size: 15px; padding: 8px 14px; border-radius: 8px;
      }
      nav.site a:hover, nav.site a.active { background: rgba(255,255,255,.12); color: #fff; }
      .hamburger {
        display: none; background: none; border: none; cursor: pointer;
        color: #fff; font-size: 24px; line-height: 1; padding: 8px 10px; border-radius: 8px;
      }
      .hamburger:hover { background: rgba(255,255,255,.12); }
      .nav-drop { position: static; }
      .nav-drop > button {
        color: #e2e8f0; background: none; border: none; cursor: pointer;
        font-size: 15px; padding: 8px 14px; border-radius: 8px; font-family: inherit; white-space: nowrap;
      }
      .nav-drop > button:hover, .nav-drop > button[aria-expanded="true"] { background: rgba(255,255,255,.12); color: #fff; }
      .nav-panel {
        position: absolute; top: 100%; left: 0; right: 0; z-index: 60;
        background: #fff; color: var(--ink); border-bottom: 1px solid var(--line);
        box-shadow: 0 12px 28px rgba(27,42,65,.16);
      }
      .nav-panel[hidden] { display: none; }
      .nav-panel .wrap { display: flex; gap: 10px; align-items: end; padding-top: 14px; padding-bottom: 16px; flex-wrap: wrap; }
      .nav-panel label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 700; color: var(--ink-soft); flex: 1 1 160px; }
      .nav-panel select {
        font-family: inherit; font-size: 15px; padding: 10px 12px; border-radius: 10px;
        border: 1.5px solid var(--line); background: #fff; color: var(--ink); max-width: 100%;
      }
      .nav-panel select:disabled { background: #f1f5f9; color: #94a3b8; }
      .nav-panel .btn { flex: 0 0 auto; }
      @media (max-width: 720px) {
        .nav-drop > button { padding: 8px 12px; font-size: 14px; }
        .nav-panel .wrap { flex-direction: column; align-items: stretch; }
        .nav-panel label { flex: 1 1 auto; }
      }
      main { min-height: 60vh; }
      footer.site { background: var(--ink); color: #cbd5e1; margin-top: 64px; }
      footer.site .wrap { padding-top: 36px; padding-bottom: 28px; }
      .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 28px; }
      footer.site h4 { color: #fff; font-size: 15px; margin-bottom: 10px; }
      footer.site p, footer.site li { font-size: 14px; }
      footer.site ul { list-style: none; }
      footer.site li { margin-bottom: 6px; }
      footer.site a { color: #fbbf24; text-decoration: none; }
      footer.site a:hover { text-decoration: underline; }
      .fine { border-top: 1px solid rgba(255,255,255,.12); margin-top: 24px; padding-top: 16px; font-size: 12.5px; color: #94a3b8; }
      .card {
        background: var(--card); border: 1px solid var(--line); border-radius: 14px;
        padding: 22px; box-shadow: 0 1px 4px rgba(27,42,65,.06);
      }
      .btn {
        display: inline-block; background: var(--accent); color: #fff !important;
        padding: 11px 22px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 15px;
        border: none; cursor: pointer;
      }
      .btn:hover { background: #92400e; }
      .btn-ghost {
        display: inline-block; border: 1.5px solid var(--line); color: var(--ink) !important;
        padding: 10px 20px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 15px; background: #fff;
      }
      .badge {
        display: inline-block; font-size: 12.5px; font-weight: 700; padding: 3px 10px;
        border-radius: 999px; border: 1.5px solid currentColor; white-space: nowrap;
      }
      .section-title { font-size: 24px; margin: 40px 0 16px; }
      @media (max-width: 720px) {
        .bar { padding: 12px 14px 10px; gap: 10px; flex-wrap: nowrap; }
        .brand { flex: 1 1 auto; }
        .brand b { font-size: 17px; }
        .brand small { display: none; }
        .hamburger { display: block; }
        nav.site {
          display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 55;
          background: var(--ink); flex-direction: column; gap: 2px;
          padding: 10px 14px 16px; box-shadow: 0 12px 28px rgba(0,0,0,.25);
        }
        nav.site.open { display: flex; }
        nav.site a { padding: 10px 12px; font-size: 15px; white-space: nowrap; }
        .nav-drop > button { padding: 10px 12px; font-size: 15px; width: 100%; text-align: left; }
        .nav-panel .wrap { flex-direction: column; align-items: stretch; }
        .nav-panel label { flex: 1 1 auto; }
        .foot-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/">
          <span class="brand-mark">अ</span>
          <span><b>AapkaNeta</b><small>har neta ka hisaab, har nagrik ke haath</small></span>
        </a>
        <button id="hamburger" class="hamburger" aria-label="Menu kholein" aria-expanded="false" aria-controls="siteNav">☰</button>
        <nav class="site" id="siteNav">
          <a href="/">Home</a>
          <a href="/gujarat/">Gujarat</a>
          <a href="/rajasthan/">Rajasthan</a>
          <a href="/uttar-pradesh/">Uttar Pradesh</a>
          <div class="nav-drop">
            <button id="kshetraBtn" aria-expanded="false" aria-controls="kshetraPanel">Kshetra ▾</button>
          </div>
          <a href="/tulna/">Comparison</a>
          <a href="/methodology/">Methodology</a>
          <a href="/rti/">File RTI</a>
          <a href="/about/">About Us</a>
        </nav>
      </div>
      <div id="kshetraPanel" class="nav-panel" hidden>
        <div class="wrap">
          <label>Rajya
            <select id="selState">
              <option value="mha">Maharashtra</option>
              <option value="guj">Gujarat</option>
              <option value="raj">Rajasthan</option>
              <option value="up">Uttar Pradesh</option>
              <option value="del">Delhi</option>
              <option value="mpst">Madhya Pradesh</option>
              <option value="bih">Bihar</option>
              <option value="asm">Assam</option>
              <option value="ker">Kerala</option>
              <option value="goa">Goa</option>
              <option value="tn">Tamil Nadu</option>
              <option value="mn">Manipur</option>
              <option value="mz">Mizoram</option>
              <option value="nl">Nagaland</option>
              <option value="jk">Jammu &amp; Kashmir</option>
            </select>
          </label>
          <label>Jila
            <select id="selDistrict"><option value="">Jila chunein…</option></select>
          </label>
          <label>Taluka
            <select id="selTaluka" disabled><option value="">Pehle jila chunein</option></select>
          </label>
          <label>Kshetra
            <select id="selAc" disabled><option value="">Pehle taluka chunein</option></select>
          </label>
          <button id="goBtn" class="btn" disabled>Dekhein →</button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <h4>AapkaNeta.org</h4>
            <p>India ka RTI-verified neta work-tracker. Har neta ne apne kshetra me kya kaam kiya — saboot ke saath, bina pakshpaat ke.</p>
            <p style="margin-top:10px">Coverage: Maharashtra (288 MLA + 48 MP) • Gujarat (182 MLA + 37 MP) • Rajasthan (200 MLA + 35 MP) • Uttar Pradesh (403 MLA + 111 MP) — halafnama record • Palghar pilot: kaam ka hisaab</p>
            <p style="margin-top:10px"><a href="mailto:hello@aapkaneta.org">hello@aapkaneta.org</a></p>
          </div>
          <div>
            <h4>Pages</h4>
            <ul>
              <li><a href="/tulna/">Comparison</a></li>
              <li><a href="/methodology/">Methodology</a></li>
              <li><a href="/rti/">File RTI</a></li>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact Us</a></li>
            </ul>
          </div>
          <div>
            <h4>Legal</h4>
            <ul>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Use</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
            </ul>
          </div>
          <div>
            <h4>About Us</h4>
            <ul>
              <li><a href="https://www.instagram.com/rtibyfiroz/" rel="noopener">Instagram — @rtibyfiroz</a></li>
            </ul>
          </div>
        </div>
        <div class="fine">
          Ye site nagrik-shiksha ke liye hai. Sabhi tathya uplabdh sarkari record, RTI jawab ya news sroton par aadharit hain. Galti dikhe to <a href="/correction/">correction bhejein</a>.
        </div>
      </div>
    </footer>
    <script is:inline>
    (function () {
      var ham = document.getElementById('hamburger');
      var nav = document.getElementById('siteNav');
      if (ham && nav) {
        ham.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = nav.classList.toggle('open');
          ham.setAttribute('aria-expanded', open ? 'true' : 'false');
          ham.setAttribute('aria-label', open ? 'Menu band karein' : 'Menu kholein');
          ham.textContent = open ? '✕' : '☰';
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a') && !e.target.closest('#kshetraBtn')) {
            nav.classList.remove('open');
            ham.setAttribute('aria-expanded', 'false');
            ham.setAttribute('aria-label', 'Menu kholein');
            ham.textContent = '☰';
          }
        });
      }
      var btn = document.getElementById('kshetraBtn');
      var panel = document.getElementById('kshetraPanel');
      var selS = document.getElementById('selState');
      var selD = document.getElementById('selDistrict');
      var selT = document.getElementById('selTaluka');
      var selA = document.getElementById('selAc');
      var go = document.getElementById('goBtn');
      if (!btn || !panel) return;
      var HIER = { mha: '/hierarchy.json', guj: '/hierarchy-gujarat.json', raj: '/hierarchy-rajasthan.json', up: '/hierarchy-uttar-pradesh.json', del: '/hierarchy-delhi.json', mpst: '/hierarchy-madhya-pradesh.json', bih: '/hierarchy-bihar.json', asm: '/hierarchy-assam.json', ker: '/hierarchy-kerala.json', goa: '/hierarchy-goa.json', tn: '/hierarchy-tamilnadu.json', mn: '/hierarchy-manipur.json', mz: '/hierarchy-mizoram.json', nl: '/hierarchy-nagaland.json', jk: '/hierarchy-jammu-kashmir.json' };
      var PREFIX = { mha: '', guj: '/gujarat', raj: '/rajasthan', up: '/uttar-pradesh', del: '/delhi', mpst: '/madhya-pradesh', bih: '/bihar', asm: '/assam', ker: '/kerala', goa: '/goa', tn: '/tamil-nadu', mn: '/manipur', mz: '/mizoram', nl: '/nagaland', jk: '/jammu-kashmir' };
      var cache = {}, data = null, curD = null, curT = null;
      function curState() { return selS ? selS.value : 'mha'; }

      function setOpen(open) {
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) loadState();
      }
      btn.addEventListener('click', function (e) { e.stopPropagation(); setOpen(panel.hidden); });
      document.addEventListener('click', function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== btn) setOpen(false);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

      function opt(select, value, text) {
        var o = document.createElement('option');
        o.value = value; o.textContent = text;
        select.appendChild(o);
      }
      function reset(select, placeholder) {
        select.innerHTML = '';
        opt(select, '', placeholder);
        select.disabled = true;
      }
      async function loadState() {
        var st = curState();
        if (cache[st]) { data = cache[st]; fillDistricts(); return; }
        try {
          var r = await fetch(HIER[st]);
          data = await r.json();
          cache[st] = data;
          fillDistricts();
        } catch (err) { /* offline: panel simply stays unusable */ }
      }
      function fillDistricts() {
        reset(selD, 'Jila chunein…');
        reset(selT, 'Taluka chunein…');
        reset(selA, 'Kshetra chunein…');
        curD = null; curT = null;
        data.districts.forEach(function (d, i) { opt(selD, String(i), d.name); });
        selD.disabled = false;
        refreshGo();
      }
      if (selS) selS.addEventListener('change', loadState);
      function target() {
        if (!curD) return null;
        var p = PREFIX[curState()];
        var a = selA.value !== '' ? JSON.parse(selA.value) : null;
        if (a) return p + '/kshetra/' + a.slug + '/';
        if (curT) return p + '/taluka/' + curD.slug + '/' + curT.slug + '/';
        return p + '/jila/' + curD.slug + '/';
      }
      function refreshGo() { go.disabled = !target(); }

      selD.addEventListener('change', function () {
        curD = data.districts[Number(selD.value)] || null;
        curT = null;
        reset(selT, 'Taluka chunein…');
        reset(selA, 'Kshetra chunein…');
        if (curD) {
          if (curD.talukas.length) {
            curD.talukas.forEach(function (t, i) { opt(selT, String(i), t.name + ' (' + t.acs.length + ')'); });
            selT.disabled = false;
            reset(selA, 'Pehle taluka chunein');
          } else {
            // Mumbai Shahar jaise jile: seedhe kshetra
            opt(selT, '', '—');
            curD.acs.forEach(function (a) { opt(selA, JSON.stringify(a), a.n + ' - ' + a.name); });
            selA.disabled = false;
          }
        }
        refreshGo();
      });
      selT.addEventListener('change', function () {
        curT = curD.talukas[Number(selT.value)] || null;
        reset(selA, 'Kshetra chunein…');
        if (curT) {
          curT.acs.forEach(function (a) { opt(selA, JSON.stringify(a), a.n + ' - ' + a.name); });
          selA.disabled = false;
        }
        refreshGo();
      });
      selA.addEventListener('change', refreshGo);
      go.addEventListener('click', function () {
        var t = target();
        if (t) window.location.href = t;
      });
    })();
    </script>
  </body>
</html>
