---
import NetaProfile from '../../../components/NetaProfile.astro';
import { mizoramNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return mizoramNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = mizoramNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/mizoram" stateName="Mizoram" homeLabel="Mizoram home" />
