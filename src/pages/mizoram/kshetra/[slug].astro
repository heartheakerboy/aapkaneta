---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { mizoramConstsAll, mizoramNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return mizoramConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = mizoramConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = mizoramNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/mizoram" stateName="Mizoram" districtHref={kshetra.district ? `/mizoram/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
