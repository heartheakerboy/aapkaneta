---
import NetaProfile from '../../../components/NetaProfile.astro';
import { arunachalNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return arunachalNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = arunachalNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/arunachal" stateName="Arunachal Pradesh" homeLabel="Arunachal Pradesh home" />
