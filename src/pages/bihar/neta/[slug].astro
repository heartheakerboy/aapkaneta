---
import NetaProfile from '../../../components/NetaProfile.astro';
import { biharNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return biharNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = biharNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/bihar" stateName="Bihar" homeLabel="Bihar home" />
