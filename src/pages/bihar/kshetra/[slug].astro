---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { biharConstsAll, biharNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return biharConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = biharConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = biharNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/bihar" stateName="Bihar" districtHref={kshetra.district ? `/bihar/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
