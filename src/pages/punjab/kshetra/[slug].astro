---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { punjabConstsAll, punjabNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return punjabConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = punjabConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = punjabNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/punjab" stateName="Punjab" districtHref={kshetra.district ? `/punjab/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
