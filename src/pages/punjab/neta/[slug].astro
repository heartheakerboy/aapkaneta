---
import NetaProfile from '../../../components/NetaProfile.astro';
import { punjabNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return punjabNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = punjabNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/punjab" stateName="Punjab" homeLabel="Punjab home" />
