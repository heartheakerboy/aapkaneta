---
import NetaProfile from '../../../components/NetaProfile.astro';
import { goaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return goaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = goaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/goa" stateName="Goa" homeLabel="Goa home" />
