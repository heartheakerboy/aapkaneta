---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { puducherryConstsAll, puducherryNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return puducherryConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = puducherryConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = puducherryNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/puducherry" stateName="Puducherry" districtHref={kshetra.district ? `/puducherry/jila/${kshetra.district.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
