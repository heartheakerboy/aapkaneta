---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { andhraConstsAll, andhraNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return andhraConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = andhraConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = andhraNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/andhra" stateName="Andhra Pradesh" districtHref={kshetra.district ? `/andhra/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
