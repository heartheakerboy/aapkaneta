---
import NetaProfile from '../../../components/NetaProfile.astro';
import { manipurNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return manipurNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = manipurNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/manipur" stateName="Manipur" homeLabel="Manipur home" />
