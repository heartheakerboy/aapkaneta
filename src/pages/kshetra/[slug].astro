---
import KshetraDetail from '../../components/KshetraDetail.astro';
import { mhaConstsAll, mhaNetasAll } from '../../data/all';
import { acTalukas, districtPath } from '../../data/geo';

export function getStaticPaths() {
  return mhaConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = mhaConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = mhaNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
const talukas = kshetra.type === 'Vidhan Sabha' && kshetra.number != null ? (acTalukas[kshetra.number] || []) : [];
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="" stateName="Maharashtra" talukas={talukas} districtHref={kshetra.district ? districtPath(kshetra.district) : null} />
