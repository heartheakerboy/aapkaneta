---
import NetaProfile from '../../../components/NetaProfile.astro';
import { haryanaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return haryanaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = haryanaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/haryana" stateName="Haryana" homeLabel="Haryana home" />
