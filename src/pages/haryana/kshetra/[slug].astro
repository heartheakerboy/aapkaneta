---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { haryanaConstsAll, haryanaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return haryanaConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = haryanaConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = haryanaNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/haryana" stateName="Haryana" districtHref={kshetra.district ? `/haryana/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
