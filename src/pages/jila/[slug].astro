---
import Layout from '../../layouts/Layout.astro';
import { netas, constituencies } from '../../data/all';
import { districtTalukas, districtSlug, talukaPath, acToPcSlug } from '../../data/geo';

export function getStaticPaths() {
  const districts = [...new Set(constituencies.filter(c => c.type === 'Vidhan Sabha').map(c => c.district))];
  return districts.map(d => ({ params: { slug: districtSlug(d) }, props: { district: d } }));
}

const { district } = Astro.props;
const talukas = districtTalukas[district] || [];
const acs = constituencies
  .filter(c => c.type === 'Vidhan Sabha' && c.district === district)
  .sort((a, b) => (a.number ?? 999) - (b.number ?? 999));
const netaByConst = Object.fromEntries(netas.filter(n => n.post === 'MLA').map(n => [n.constituencySlug, n]));
const mpBySlug = Object.fromEntries(netas.filter(n => n.post === 'MP').map(n => [n.constituencySlug, n]));
const pcSlugs = [...new Set(acs.map(a => a.number).filter(n => n != null).map(n => acToPcSlug[n!]).filter(Boolean))];
const mps = pcSlugs.map(s => mpBySlug[s]).filter(Boolean);
const withWorks = acs.filter(a => (netaByConst[a.slug]?.works.length ?? 0) > 0).length;
---

<Layout title={`${district} jila — neta aur kshetra`} description={`${district} jile ke ${acs.length} Vidhan Sabha kshetron ke MLA, taluke aur Lok Sabha kshetron ki suchi.`}>
  <div class="k-hero">
    <div class="wrap">
      <a class="back" href="/">← Home</a>
      <h1>Jila {district}</h1>
      <div class="k-meta">{acs.length} Vidhan Sabha kshetra • {talukas.length} taluke • Maharashtra</div>
    </div>
  </div>

  <div class="wrap">
    <h2 class="section-title">Taluke <span>({talukas.length})</span></h2>
    {talukas.length === 0 ? (
      <p class="note">Mumbai Shahar poori tarah shahri jila hai — yahan taluka vyavastha lagu nahi hoti.</p>
    ) : (
      <div class="chips">
        {talukas.map(t => <a class="chip" href={talukaPath(district, t)}>{t}</a>)}
      </div>
    )}

    {mps.length > 0 && (
      <>
        <h2 class="section-title">Lok Sabha kshetra <span>({mps.length})</span></h2>
        <div class="chips">
          {mps.map(m => <a class="chip" href={`/neta/${m.slug}`}>{m.constituency.replace(' (Lok Sabha)', '')} — {m.name}</a>)}
        </div>
      </>
    )}

    <h2 class="section-title">Vidhan Sabha kshetra <span>({acs.length} — {withWorks} me verified kaam)</span></h2>
    <div class="ac-list">
      {acs.map(a => {
        const n = netaByConst[a.slug];
        return (
          <a class="ac-row" href={`/kshetra/${a.slug}`}>
            <span class="ac-num">{a.number}</span>
            <span class="ac-name">{a.name}{a.reservation && a.reservation !== '—' ? ` (${a.reservation})` : ''}</span>
            <span class="ac-mla">{n ? n.name : '—'}</span>
            <span class="ac-works">{n ? `${n.works.length} kaam` : ''}</span>
          </a>
        );
      })}
    </div>
    <p class="src-note">Taluka suchi: Bharat Nirvachan Aayog — Delimitation of Parliamentary and Assembly Constituencies Order, 2008 (CEO Maharashtra).</p>
  </div>
</Layout>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 8px; }
  .chip { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; text-decoration: none; color: var(--ink); font-size: 15px; }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .note { color: var(--ink-soft); }
  .ac-list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .ac-row { display: grid; grid-template-columns: 52px 1fr auto auto; gap: 12px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; text-decoration: none; color: inherit; }
  .ac-row:hover { border-color: var(--accent); }
  .ac-num { font-weight: 800; color: var(--accent); }
  .ac-name { font-weight: 600; }
  .ac-mla { color: var(--ink-soft); font-size: 14px; }
  .ac-works { font-size: 13px; color: var(--ink-soft); white-space: nowrap; }
  .src-note { margin-top: 22px; font-size: 13px; color: var(--ink-soft); }
  @media (max-width: 640px) { .ac-row { grid-template-columns: 44px 1fr; } .ac-mla, .ac-works { display: none; } }
</style>
