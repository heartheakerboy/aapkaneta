---
import JilaDetail from '../../components/JilaDetail.astro';
import { mhaConstsAll, mhaNetasAll } from '../../data/all';
import { districtTalukas, districtSlug, talukaPath, acToPcSlug } from '../../data/geo';

export function getStaticPaths() {
  const districts = [...new Set(mhaConstsAll.filter(c => c.type === 'Vidhan Sabha').map(c => c.district))];
  return districts.map(d => ({ params: { slug: districtSlug(d) }, props: { district: d } }));
}

const { district } = Astro.props;
const talukas = districtTalukas[district] || [];
const acs = mhaConstsAll
  .filter(c => c.type === 'Vidhan Sabha' && c.district === district)
  .sort((a, b) => (a.number ?? 999) - (b.number ?? 999));
const netaByConst: Record<string, (typeof mhaNetasAll)[number]> = Object.fromEntries(mhaNetasAll.filter(n => n.post === 'MLA').map(n => [n.constituencySlug, n]));
const mpBySlug = Object.fromEntries(mhaNetasAll.filter(n => n.post === 'MP').map(n => [n.constituencySlug, n]));
const pcSlugs = [...new Set(acs.map(a => a.number).filter(n => n != null).map(n => acToPcSlug[n!]).filter(Boolean))];
const mps = pcSlugs.map(s => mpBySlug[s]).filter(Boolean);
---

<JilaDetail district={district} districtSlugStr={districtSlug(district)} acs={acs} netaByConst={netaByConst} mps={mps} talukas={talukas} base="" stateName="Maharashtra" srcNote="Taluka suchi: Bharat Nirvachan Aayog — Delimitation of Parliamentary and Assembly Constituencies Order, 2008 (CEO Maharashtra)." />
