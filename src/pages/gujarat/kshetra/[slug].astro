---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { gujConstsAll, gujNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return gujConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = gujConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = gujNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/gujarat" stateName="Gujarat" districtHref={kshetra.district ? `/gujarat/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}` : null} />
