---
import NetaProfile from '../../../components/NetaProfile.astro';
import { gujNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return gujNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = gujNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/gujarat" stateName="Gujarat" homeLabel="Gujarat home" />
