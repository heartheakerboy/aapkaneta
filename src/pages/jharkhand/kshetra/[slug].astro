---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { jharkhandConstsAll, jharkhandNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return jharkhandConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = jharkhandConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = jharkhandNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/jharkhand" stateName="Jharkhand" districtHref={kshetra.district ? `/jharkhand/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
