---
import NetaProfile from '../../../components/NetaProfile.astro';
import { jharkhandNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return jharkhandNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = jharkhandNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/jharkhand" stateName="Jharkhand" homeLabel="Jharkhand home" />
