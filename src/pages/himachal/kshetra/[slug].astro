---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { himachalConstsAll, himachalNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return himachalConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = himachalConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = himachalNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/himachal" stateName="Himachal Pradesh" districtHref={kshetra.district ? `/himachal/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
