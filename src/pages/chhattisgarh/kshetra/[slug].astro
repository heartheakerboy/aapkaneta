---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { chhattisgarhConstsAll, chhattisgarhNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return chhattisgarhConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = chhattisgarhConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = chhattisgarhNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/chhattisgarh" stateName="Chhattisgarh" districtHref={kshetra.district ? `/chhattisgarh/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
