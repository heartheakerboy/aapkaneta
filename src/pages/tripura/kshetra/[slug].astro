---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { tripuraConstsAll, tripuraNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return tripuraConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = tripuraConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = tripuraNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/tripura" stateName="Tripura" districtHref={kshetra.district ? `/tripura/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
