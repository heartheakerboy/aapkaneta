---
import Layout from '../layouts/Layout.astro';
import { netas, badgeMeta } from '../data/pilot';

const initials = (name: string) => name.split(' ').map(w => w[0]).slice(0, 2).join('');
---

<Layout title="AapkaNeta — Har neta ka hisaab, har nagrik ke haath">
  <style>
    .hero { background: linear-gradient(160deg, #1b2a41 0%, #243b5c 70%, #2e4a73 100%); color: #fff; padding: 64px 0 56px; }
    .hero h1 { font-size: 42px; line-height: 1.25; max-width: 720px; }
    .hero h1 span { color: #fbbf24; }
    .hero p { color: #cbd5e1; font-size: 18px; max-width: 640px; margin-top: 14px; }
    .searchbox { margin-top: 26px; max-width: 560px; display: flex; gap: 8px; }
    .searchbox input {
      flex: 1; padding: 13px 16px; border-radius: 10px; border: none; font-size: 16px; font-family: inherit;
    }
    .searchbox input:focus { outline: 3px solid #f59e0b; }
    .pilot-tag {
      display: inline-block; margin-top: 18px; background: rgba(251,191,36,.15); color: #fbbf24;
      border: 1px solid rgba(251,191,36,.5); padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 600;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; margin-top: 20px; }
    .cta-card {
      display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 10px;
      background: linear-gradient(150deg, #1b2a41, #2e4a73); color: #fff; text-decoration: none;
      border-radius: 14px; padding: 22px; min-height: 100%;
    }
    .cta-card h3 { font-size: 19px; line-height: 1.35; }
    .cta-card p { font-size: 14px; color: #cbd5e1; }
    .cta-card span.link { color: #fbbf24; font-weight: 700; font-size: 15px; }
    .neta-card { text-decoration: none; color: inherit; transition: transform .12s ease, box-shadow .12s ease; display: block; }
    .neta-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(27,42,65,.12); }
    .neta-top { display: flex; gap: 14px; align-items: center; }
    .avatar {
      width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg, #1b2a41, #3d5a80);
      color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 20px; flex-shrink: 0;
    }
    .neta-card h3 { font-size: 18px; line-height: 1.3; }
    .neta-meta { font-size: 14px; color: var(--ink-soft); margin-top: 4px; }
    .party-pill {
      display: inline-block; font-size: 12.5px; font-weight: 700; background: var(--accent-soft);
      color: var(--accent); padding: 2px 10px; border-radius: 999px; margin-top: 8px;
    }
    .neta-foot { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 14px; color: var(--ink-soft); display: flex; justify-content: space-between; align-items: center; }
    .hidden-card { display: none !important; }
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 20px; }
    .step-num {
      width: 38px; height: 38px; border-radius: 50%; background: var(--ink); color: #fff;
      display: grid; place-items: center; font-weight: 800; margin-bottom: 10px;
    }
    .cta-band { background: var(--ink); color: #fff; border-radius: 18px; padding: 40px; margin-top: 56px; display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
    .cta-band h2 { font-size: 26px; margin-bottom: 8px; }
    .cta-band p { color: #cbd5e1; max-width: 560px; }
    .no-results { display: none; text-align: center; padding: 30px; color: var(--ink-soft); }
    @media (max-width: 720px) { .hero h1 { font-size: 30px; } }
  </style>

  <section class="hero">
    <div class="wrap">
      <h1>Aapke neta ne <span>aapke kshetra</span> me kya kaam kiya?</h1>
      <p>Saboot ke saath, bina pakshpaat ke. Har kaam ke saath uska source — sarkari record, RTI jawab, ya news report.</p>
      <div class="searchbox">
        <input id="q" type="search" placeholder="Neta ya kshetra ka naam likhein… (jaise: Vasai, Savara)" autocomplete="off" />
      </div>
      <span class="pilot-tag">📍 Pilot live: Palghar jila, Maharashtra — 7 neta</span>
    </div>
  </section>

  <div class="wrap">
    <h2 class="section-title">Palghar ke neta</h2>
    <div class="grid" id="netaGrid">
      {netas.map(n => (
        <a class="neta-card card" href={`/neta/${n.slug}`} data-search={`${n.name} ${n.constituency} ${n.party} ${n.partyShort}`.toLowerCase()}>
          <div class="neta-top">
            <div class="avatar">{initials(n.name)}</div>
            <div>
              <h3>{n.name}</h3>
              <div class="neta-meta">{n.post} • {n.constituency}</div>
            </div>
          </div>
          <span class="party-pill">{n.partyShort}</span>
          <div class="neta-foot">
            <span>{n.works.length} verified kaam</span>
            <span>Profile dekhein →</span>
          </div>
        </a>
      ))}
      <a class="cta-card" href="/rti">
        <h3>Aur bhi neta jud rahe hain</h3>
        <p>Maharashtra ke 288 MLA — dheere-dheere. RTI drive me hissa lo, apne kshetra ka hisaab sabse pehle lao.</p>
        <span class="link">RTI Drive me hissa lo →</span>
      </a>
    </div>
    <div class="no-results card" id="noResults">Koi neta nahi mila — spelling badal kar try karein.</div>

    <h2 class="section-title">Ye kaam kaise karta hai?</h2>
    <div class="steps">
      <div class="card">
        <div class="step-num">1</div>
        <h3>Data jama karo</h3>
        <p style="color:var(--ink-soft);font-size:15px">MPLADS portal, ECI halafname, news archive — aur sabse khaas, <b>RTI jawab</b>.</p>
      </div>
      <div class="card">
        <div class="step-num">2</div>
        <h3>Verify karo</h3>
        <p style="color:var(--ink-soft);font-size:15px">Har kaam ko badge milta hai: {badgeMeta.sarkari.label}, {badgeMeta.rti.label}, {badgeMeta.news.label} ya {badgeMeta.dawa.label}.</p>
      </div>
      <div class="card">
        <div class="step-num">3</div>
        <h3>Public karo</h3>
        <p style="color:var(--ink-soft);font-size:15px">Bina badge ke koi "kaam" list me nahi aata. Galti mile to 48 ghante me sudhaar.</p>
      </div>
    </div>

    <div class="cta-band">
      <div style="flex:1;min-width:260px">
        <h2>RTI Drive #1 — Palghar</h2>
        <p>6 Vidhan Sabha seaton ke MLA fund ka hisaab RTI se mang rahe hain. Template taiyaar hai — aap bhi apne kshetra ke liye RTI lagao, jawab aate hi site par "RTI Verified" badge ke saath publish hoga.</p>
      </div>
      <div>
        <a class="btn" href="/rti">RTI Template Dekhein</a>
      </div>
    </div>
  </div>

  <script>
    const q = document.getElementById('q');
    const cards = Array.from(document.querySelectorAll('.neta-card'));
    const noResults = document.getElementById('noResults');
    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach(c => {
        const hit = !v || c.dataset.search.includes(v);
        c.classList.toggle('hidden-card', !hit);
        if (hit) visible++;
      });
      noResults.style.display = visible ? 'none' : 'block';
    });
  </script>
</Layout>
