---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { upConstsAll, upNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return upConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = upConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = upNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/uttar-pradesh" stateName="Uttar Pradesh" districtHref={kshetra.district ? `/uttar-pradesh/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
