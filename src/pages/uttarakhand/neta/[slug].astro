---
import NetaProfile from '../../../components/NetaProfile.astro';
import { uttarakhandNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return uttarakhandNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = uttarakhandNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/uttarakhand" stateName="Uttarakhand" homeLabel="Uttarakhand home" />
