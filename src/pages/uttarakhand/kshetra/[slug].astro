---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { uttarakhandConstsAll, uttarakhandNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return uttarakhandConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = uttarakhandConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = uttarakhandNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/uttarakhand" stateName="Uttarakhand" districtHref={kshetra.district ? `/uttarakhand/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
