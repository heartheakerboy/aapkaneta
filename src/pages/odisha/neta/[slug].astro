---
import NetaProfile from '../../../components/NetaProfile.astro';
import { odishaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return odishaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = odishaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/odisha" stateName="Odisha" homeLabel="Odisha home" />
