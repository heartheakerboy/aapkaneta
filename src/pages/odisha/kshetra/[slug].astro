---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { odishaConstsAll, odishaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return odishaConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = odishaConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = odishaNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/odisha" stateName="Odisha" districtHref={kshetra.district ? `/odisha/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
