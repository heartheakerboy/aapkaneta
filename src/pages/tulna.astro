---
import Layout from '../layouts/Layout.astro';
import { netas } from '../data/pilot';
---

<Layout title="Netavon ki tulna — Palghar" description="Palghar jile ke netaon ki tulna: pad, party, karyakaal, fund utilization aur verified kaam.">
  <style>
    .t-hero { background: var(--ink); color: #fff; padding: 44px 0; }
    .t-hero h1 { font-size: 32px; }
    .t-hero p { color: #cbd5e1; margin-top: 8px; }
    .table-wrap { overflow-x: auto; margin-top: 28px; }
    table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 14px; overflow: hidden; font-size: 15px; min-width: 760px; }
    th { background: var(--ink); color: #fff; text-align: left; padding: 14px 16px; font-size: 14px; }
    td { padding: 14px 16px; border-bottom: 1px solid var(--line); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #fdfbf6; }
    td a { font-weight: 700; color: var(--ink); text-decoration: none; }
    td a:hover { color: var(--accent); }
    .note { font-size: 14px; color: var(--ink-soft); margin-top: 16px; }
  </style>

  <div class="t-hero">
    <div class="wrap">
      <h1>Netavon ki tulna</h1>
      <p>Palghar jila — ek nazar me 7 neta. Tathya record ke anusaar, raay aapki.</p>
    </div>
  </div>

  <div class="wrap">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Neta</th>
            <th>Pad</th>
            <th>Kshetra</th>
            <th>Party</th>
            <th>Aaparaadhik mamle</th>
            <th>Sampatti (halafnama)</th>
            <th>Verified kaam</th>
            <th>Fund utilization</th>
          </tr>
        </thead>
        <tbody>
          {netas.map(n => (
            <tr>
              <td><a href={`/neta/${n.slug}`}>{n.name}</a></td>
              <td>{n.post}</td>
              <td>{n.constituency}</td>
              <td>{n.partyShort}</td>
              <td>{n.background.criminalCases}</td>
              <td style="white-space:nowrap">{n.background.assets}</td>
              <td>{n.works.filter(w=>w.badge!=='dawa').length}</td>
              <td>{n.fund?.utilizationPct != null ? n.fund.utilizationPct + '%' : 'record baaki'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">* "Record baaki" ka matlab hai data jama kiya ja raha hai — ye kisi neta ke khilaf tippani nahi hai. <a href="/methodology">Methodology padhein</a>.</p>
  </div>
</Layout>
