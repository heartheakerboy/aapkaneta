---
import NetaProfile from '../../components/NetaProfile.astro';
import { mhaNetasAll } from '../../data/all';

export function getStaticPaths() {
  return mhaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = mhaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="" stateName="Maharashtra" homeLabel="Sabhi neta" />
