---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { telanganaConstsAll, telanganaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return telanganaConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = telanganaConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = telanganaNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/telangana" stateName="Telangana" districtHref={kshetra.district ? `/telangana/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
