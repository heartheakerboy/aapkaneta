---
import NetaProfile from '../../../components/NetaProfile.astro';
import { telanganaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return telanganaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = telanganaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/telangana" stateName="Telangana" homeLabel="Telangana home" />
