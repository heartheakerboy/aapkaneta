---
import Layout from '../layouts/Layout.astro';
import { allConstituencies, allNetas } from '../data/all';

const mhaAssembly = allConstituencies
  .filter(c => c.type === 'Vidhan Sabha' && !['Gujarat', 'Rajasthan', 'Uttar Pradesh'].includes((c as any).state))
  .sort((a, b) => a.district.localeCompare(b.district, 'en') || (a.number ?? 0) - (b.number ?? 0));
const gujAssembly = allConstituencies
  .filter(c => c.type === 'Vidhan Sabha' && (c as any).state === 'Gujarat')
  .sort((a, b) => a.district.localeCompare(b.district, 'en') || (a.number ?? 0) - (b.number ?? 0));

const mhaDistricts = [...new Set(mhaAssembly.map(c => c.district))].sort();
const gujDistricts = [...new Set(gujAssembly.map(c => c.district))].sort();
const rajAssembly = allConstituencies
  .filter(c => c.type === 'Vidhan Sabha' && (c as any).state === 'Rajasthan')
  .sort((a, b) => a.district.localeCompare(b.district, 'en') || (a.number ?? 0) - (b.number ?? 0));
const rajDistricts = [...new Set(rajAssembly.map(c => c.district))].sort();
const upAssembly = allConstituencies
  .filter(c => c.type === 'Vidhan Sabha' && (c as any).state === 'Uttar Pradesh')
  .sort((a, b) => a.district.localeCompare(b.district, 'en') || (a.number ?? 0) - (b.number ?? 0));
const upDistricts = [...new Set(upAssembly.map(c => c.district))].sort();

function netaFor(state: string, slug: string): string {
  const n = allNetas.find(n => ((n.state ?? 'Maharashtra') === state) && n.tenures.some(t => t.constituencySlug === slug));
  return n?.name ?? 'maananeey vidhaayak';
}

function templateFor(state: string, c: { slug: string; name: string; district: string }): string {
  const neta = netaFor(state, c.slug);
  return `Seva me,\nJan Soochna Adhikaari,\nJila Niyojan Adhikaari, ${c.district}\n\nVishay: ${c.name} Vidhan Sabha kshetra me Vidhayak Kshetra Vikas Nidhi (MLALADS) se sambandhit soochna — RTI 2005 ki dhaara 6(1) ke antargat\n\nMahoday,\n\nKripya nimn soochna uplabdh karayein:\n\n1. Vitt varsh 2024-25 aur 2025-26 me ${c.name} kshetra ke liye MLALADS ke tahat kul kitni raashi aavantit hui?\n2. Ukt avadhi me ${neta} dwara kaun-kaun se kaam swikrit kiye gaye? (kaam ka naam, sthal, laagat sahit soochi)\n3. Inme se kitne kaam poore hue, kitne pragati par hain, kitne shuru nahi hue?\n4. Poore hue kaamon ke completion certificate ki prati uplabdh karayein.\n\nAavedak ka naam/pata:\n[Apna naam]\n[Apna pata]\n\nDinank: [tareekh]`;
}
---

<Layout title="File RTI — Apne neta ka hisaab mango" description="Apne MLA par RTI kaise lagayein: Maharashtra ki 288 Vidhan Sabha seaton ke liye taiyaar template. Jawab aate hi AapkaNeta par RTI Verified badge ke saath publish hoga.">
  <style>
    .r-hero { background: linear-gradient(160deg, #1b2a41, #2e4a73); color: #fff; padding: 44px 0; }
    .r-hero h1 { font-size: 32px; }
    .r-hero p { color: #cbd5e1; margin-top: 8px; max-width: 680px; }
    .r-hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 28px; align-items: center; }
    .r-hero-card { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); border-radius: 14px; padding: 22px; }
    .r-hero-card > b { font-size: 17px; color: #fbbf24; }
    .r-hero-stats { display: flex; gap: 22px; margin: 12px 0; }
    .r-hero-stats div { text-align: center; }
    .r-hero-stats strong { display: block; font-size: 26px; color: #fff; }
    .r-hero-stats span { font-size: 13px; color: #cbd5e1; }
    .r-hero-card p { font-size: 14px; }
    @media (max-width: 720px) { .r-hero-grid { grid-template-columns: 1fr; } }
    .filter-bar { display: flex; gap: 12px; flex-wrap: wrap; margin: 18px 0; }
    .filter-bar select, .filter-bar input {
      padding: 10px 12px; font-size: 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit;
    }
    .filter-bar input { flex: 1; min-width: 200px; }
    .tpl { margin-bottom: 20px; }
    .tpl.hidden { display: none; }
    .tpl-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
    .tpl-head h3 { font-size: 19px; }
    .tpl-head .dist-tag { font-size: 13px; color: var(--ink-soft); font-weight: 400; }
    pre.tpl-body {
      background: #1b2a41; color: #e2e8f0; padding: 20px; border-radius: 12px;
      font-size: 13.5px; line-height: 1.7; white-space: pre-wrap; font-family: ui-monospace, monospace;
      max-height: 340px; overflow-y: auto;
    }
    .copy-btn { background: var(--accent); color: #fff; border: none; padding: 9px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; font-family: inherit; }
    .copy-btn:hover { background: #92400e; }
    .howto { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 20px; }
    #noResult { display: none; text-align: center; padding: 30px; color: var(--ink-soft); }
  </style>

  <div class="r-hero">
    <div class="wrap r-hero-grid">
      <div>
        <h1>File RTI</h1>
        <p>Maharashtra, Gujarat aur Uttar Pradesh me MLA fund ka record online nahi milta — isliye RTI hi rasta hai. Neeche <b>1073 seaton</b> ke liye taiyaar template hai — apna rajya aur jila chunein, template copy karo, apna naam-pata bharke sambandhit adhikaari ko bhejo. Jawab aate hi humein bhejo — "RTI Verified" badge ke saath site par publish hoga.</p>
      </div>
      <div class="r-hero-card">
        <b>RTI Drive</b>
        <div class="r-hero-stats">
          <div><strong>1073</strong><span>seats</span></div>
          <div><strong>1073</strong><span>templates</span></div>
          <div><strong>₹10</strong><span>fees</span></div>
        </div>
        <p>Jawab 30 din me aata hai. Scan bhejo — verification ke baad neta ke profile par lagega.</p>
      </div>
    </div>
  </div>

  <div class="wrap">
    <h2 class="section-title">RTI kaise lagayein?</h2>
    <div class="howto">
      <div class="card"><b>1. Apna kshetra chunein</b><p style="font-size:14.5px;color:var(--ink-soft)">Neeche jila ya seat ka naam likhkar apna template dhoondhein.</p></div>
      <div class="card"><b>2. Template copy karo</b><p style="font-size:14.5px;color:var(--ink-soft)">Copy karke apna naam-pata bharein.</p></div>
      <div class="card"><b>2. Online ya offline bhejo</b><p style="font-size:14.5px;color:var(--ink-soft)">Maharashtra: <a href="https://rtionline.maharashtra.gov.in/" rel="noopener">rtionline.maharashtra.gov.in</a> ya sambandhit karyalaya me. Fees: ₹10.</p></div>
      <div class="card"><b>4. Jawab humein bhejo</b><p style="font-size:14.5px;color:var(--ink-soft)">30 din me jawab aayega. Scan humein bhejo — verification ke baad neta ke profile par lagega.</p></div>
    </div>

    <h2 class="section-title">1073 seaton ke taiyaar templates</h2>
    <div class="filter-bar">
      <select id="stateFilter" aria-label="Rajya chunein">
        <option value="Maharashtra">Maharashtra (288)</option>
        <option value="Gujarat">Gujarat (182)</option>
        <option value="Rajasthan">Rajasthan (200)</option>
        <option value="Uttar Pradesh">Uttar Pradesh (403)</option>
      </select>
      <select id="distFilter" aria-label="Jila chunein">
        <option value="">Saare jile</option>
      </select>
      <input id="seatSearch" type="text" placeholder="Seat ka naam likhein… (jaise: Dahanu, Kopargaon)" aria-label="Seat khojein" />
    </div>
    <div id="noResult">Koi seat nahi mili — spelling check karein ya jila badlein.</div>
    {mhaAssembly.map(c => (
      <div class="card tpl" data-state="Maharashtra" data-district={c.district} data-seat={c.slug} data-name={c.name.toLowerCase()} id={`tpl-card-${c.slug}`}>
        <div class="tpl-head">
          <h3>{c.name} <span class="dist-tag">({c.district}{c.number ? ` — No. ${c.number}` : ''})</span></h3>
          <button class="copy-btn" data-tpl={c.slug}>Copy karo</button>
        </div>
        <pre class="tpl-body" id={`tpl-${c.slug}`}>{templateFor('Maharashtra', c)}</pre>
      </div>
    ))}
    {gujAssembly.map(c => (
      <div class="card tpl" data-state="Gujarat" data-district={c.district} data-seat={'guj-' + c.slug} data-name={c.name.toLowerCase()} id={`tpl-card-guj-${c.slug}`}>
        <div class="tpl-head">
          <h3>{c.name} <span class="dist-tag">({c.district}{c.number ? ` — No. ${c.number}` : ''})</span></h3>
          <button class="copy-btn" data-tpl={'guj-' + c.slug}>Copy karo</button>
        </div>
        <pre class="tpl-body" id={`tpl-guj-${c.slug}`}>{templateFor('Gujarat', c)}</pre>
      </div>
    ))}
    {rajAssembly.map(c => (
      <div class="card tpl" data-state="Rajasthan" data-district={c.district} data-seat={'raj-' + c.slug} data-name={c.name.toLowerCase()} id={`tpl-card-raj-${c.slug}`}>
        <div class="tpl-head">
          <h3>{c.name} <span class="dist-tag">({c.district}{c.number ? ` — No. ${c.number}` : ''})</span></h3>
          <button class="copy-btn" data-tpl={'raj-' + c.slug}>Copy karo</button>
        </div>
        <pre class="tpl-body" id={`tpl-raj-${c.slug}`}>{templateFor('Rajasthan', c)}</pre>
      </div>
    ))}
    {upAssembly.map(c => (
      <div class="card tpl" data-state="Uttar Pradesh" data-district={c.district} data-seat={'up-' + c.slug} data-name={c.name.toLowerCase()} id={`tpl-card-up-${c.slug}`}>
        <div class="tpl-head">
          <h3>{c.name} <span class="dist-tag">({c.district}{c.number ? ` — No. ${c.number}` : ''})</span></h3>
          <button class="copy-btn" data-tpl={'up-' + c.slug}>Copy karo</button>
        </div>
        <pre class="tpl-body" id={`tpl-up-${c.slug}`}>{templateFor('Uttar Pradesh', c)}</pre>
      </div>
    ))}
    <p style="font-size:14px;color:var(--ink-soft);margin:24px 0 8px">
      Note: Ye template nagrik-shiksha ke liye hai. RTI lagane se pehle <a href="https://www.instagram.com/rtibyfiroz/" rel="noopener">@rtibyfiroz</a> par RTI ki sahi prakriya samajh lein.
    </p>
    <script type="application/json" id="rajDistricts">{JSON.stringify(rajDistricts)}</script>
    <script type="application/json" id="upDistricts">{JSON.stringify(upDistricts)}</script>
  </div>

  <script is:inline>
    (function () {
      var stateSel = document.getElementById('stateFilter');
      var distSel = document.getElementById('distFilter');
      var search = document.getElementById('seatSearch');
      var cards = Array.prototype.slice.call(document.querySelectorAll('.tpl'));
      var noResult = document.getElementById('noResult');
      var distByState = {
        'Maharashtra': ['Ahmednagar','Akola','Amaravati','Aurangabad','Beed','Bhandara','Buldhana','Chandrapur','Dhule','Gadchiroli','Gondiya','Hingoli','Jalgaon','Jalna','Kolhapur','Latur','Mumbai City','Mumbai Suburban','Nagpur','Nanded','Nandurabar','Nashik','Osmanabad','Parbhani','Pune','Raigad','Ratnagiri','Sangli','Satara','Sindhudurg','Solapur','Thane','Wardha','Washim','Yavatmal'],
        'Gujarat': ['Ahmedabad','Amreli','Anand','Aravalli','Banaskantha','Bharuch','Bhavnagar','Botad','Chhota Udaipur','Dahod','Dang','Devbhoomi Dwarka','Gandhinagar','Gir Somnath','Jamnagar','Junagadh','Kachchh','Kheda','Mahesana','Mahisagar','Morbi','Narmada','Navsari','Panchmahal','Patan','Porbandar','Rajkot','Sabarkantha','Surat','Surendranagar','Tapi','Vadodara','Valsad','Vav-Tharad'],
        'Rajasthan': JSON.parse(document.getElementById('rajDistricts').textContent),
        'Uttar Pradesh': JSON.parse(document.getElementById('upDistricts').textContent)
      };

      function rebuildDistricts() {
        var st = stateSel.value;
        distSel.innerHTML = '<option value="">Saare jile</option>';
        distByState[st].forEach(function (d) {
          var o = document.createElement('option');
          o.value = d; o.textContent = d;
          distSel.appendChild(o);
        });
      }

      function applyFilter() {
        var st = stateSel.value;
        var d = distSel.value;
        var q = search.value.trim().toLowerCase();
        var shown = 0;
        cards.forEach(function (card) {
          var okS = card.getAttribute('data-state') === st;
          var okD = !d || card.getAttribute('data-district') === d;
          var okQ = !q || card.getAttribute('data-name').indexOf(q) !== -1;
          var show = okS && okD && okQ;
          card.classList.toggle('hidden', !show);
          if (show) shown++;
        });
        noResult.style.display = shown ? 'none' : 'block';
      }
      stateSel.addEventListener('change', function () { rebuildDistricts(); applyFilter(); });
      distSel.addEventListener('change', applyFilter);
      search.addEventListener('input', applyFilter);
      rebuildDistricts();
      applyFilter();

      // ?seat=<slug> aaye to seedha us seat ka template dikhao
      var params = new URLSearchParams(location.search);
      var seat = params.get('seat');
      var stParam = params.get('state');
      var stPfx = stParam === 'Gujarat' ? 'guj-' : stParam === 'Rajasthan' ? 'raj-' : stParam === 'Uttar Pradesh' ? 'up-' : '';
      if (stParam === 'Gujarat' || stParam === 'Rajasthan' || stParam === 'Uttar Pradesh') {
        stateSel.value = stParam;
        rebuildDistricts();
      }
      if (seat) {
        var pid = 'tpl-card-' + stPfx + seat;
        var mid = 'tpl-card-' + seat;
        var gid = 'tpl-card-guj-' + seat;
        var target = (stPfx && document.getElementById(pid)) || document.getElementById(mid) || document.getElementById(gid) || document.getElementById('tpl-card-raj-' + seat) || document.getElementById('tpl-card-up-' + seat);
        if (target) {
          distSel.value = '';
          search.value = '';
          applyFilter();
          cards.forEach(function (card) {
            card.classList.toggle('hidden', card.getAttribute('data-seat') !== seat && card.getAttribute('data-seat') !== stPfx + seat);
          });
          noResult.style.display = 'none';
          setTimeout(function () {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 300);
        }
      }

      document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-tpl');
          var pre = document.getElementById('tpl-' + slug);
          var done = function () {
            var old = btn.textContent;
            btn.textContent = 'Copied ✓';
            setTimeout(function () { btn.textContent = old; }, 1800);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(pre.innerText).then(done).catch(function () { fallback(); });
          } else { fallback(); }
          function fallback() {
            var r = document.createRange();
            r.selectNodeContents(pre);
            var s = getSelection(); s.removeAllRanges(); s.addRange(r);
            try { document.execCommand('copy'); } catch (e) {}
            s.removeAllRanges();
            done();
          }
        });
      });
    })();
  </script>
</Layout>
