---
import NetaProfile from '../../../components/NetaProfile.astro';
import { assamNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return assamNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = assamNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/assam" stateName="Assam" homeLabel="Assam home" />
