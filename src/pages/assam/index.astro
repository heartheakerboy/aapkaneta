---
import Layout from '../../layouts/Layout.astro';
import { assamNetasAll, assamConstsAll } from '../../data/all';

function districtSlug(d: string): string {
  return d.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const initials = (name: string) => name.split(' ').map(w => w[0]).slice(0, 2).join('');

const mlas = assamNetasAll.filter(n => n.post === 'MLA');
const mps = assamNetasAll.filter(n => n.post === 'MP' && n.house !== 'Rajya Sabha');
const rsMps = assamNetasAll.filter(n => n.post === 'MP' && n.house === 'Rajya Sabha');

const constBySlug: Record<string, (typeof assamConstsAll)[number]> = Object.fromEntries(assamConstsAll.map(c => [c.slug, c]));
const byDistrict = new Map<string, typeof mlas>();
for (const n of mlas) {
  const d = constBySlug[n.constituencySlug]?.district || 'Anya';
  if (!byDistrict.has(d)) byDistrict.set(d, []);
  byDistrict.get(d)!.push(n);
}
const districts = [...byDistrict.entries()].sort((a, b) => a[0].localeCompare(b[0], 'en'));
for (const [, arr] of districts) {
  arr.sort((x, y) => (constBySlug[x.constituencySlug]?.number ?? 999) - (constBySlug[y.constituencySlug]?.number ?? 999));
}
---

<Layout title="Assam — Har neta ka hisaab" description="Assam ke 126 MLA, 14 Lok Sabha MP aur 7 Rajya Sabha MP — halafnama record aur kaam ka satyaapit hisaab.">
  <style>
    .hero { background: linear-gradient(160deg, #1b2a41 0%, #243b5c 70%, #2e4a73 100%); color: #fff; padding: 56px 0 48px; }
    .hero h1 { font-size: 38px; line-height: 1.25; }
    .hero h1 span { color: #fbbf24; }
    .hero p { color: #cbd5e1; font-size: 17px; max-width: 640px; margin-top: 12px; }
    .hero-stats { display: flex; gap: 26px; margin-top: 20px; flex-wrap: wrap; }
    .hero-stats div { text-align: center; }
    .hero-stats strong { display: block; font-size: 30px; color: #fff; }
    .hero-stats span { font-size: 13px; color: #cbd5e1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; margin-top: 20px; }
    .group-title { font-size: 22px; margin: 30px 0 4px; }
    .group-title span { font-size: 15px; font-weight: 400; color: var(--ink-soft); }
    .dist-group { margin-top: 22px; }
    .dist-title { font-size: 17px; color: var(--ink); border-left: 4px solid var(--accent); padding-left: 10px; margin-bottom: 2px; }
    .dist-title a { color: inherit; text-decoration: none; }
    .dist-title a:hover { color: var(--accent); }
    .dist-title span { font-size: 13.5px; font-weight: 400; color: var(--ink-soft); }
    .neta-card { text-decoration: none; color: inherit; transition: transform .12s ease, box-shadow .12s ease; display: block; }
    .neta-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(27,42,65,.12); }
    .neta-top { display: flex; gap: 14px; align-items: center; }
    .avatar { width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg, #1b2a41, #3d5a80); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 20px; flex-shrink: 0; }
    .neta-card h3 { font-size: 18px; line-height: 1.3; }
    .neta-meta { font-size: 14px; color: var(--ink-soft); margin-top: 4px; }
    .party-pill { display: inline-block; font-size: 12.5px; font-weight: 700; background: var(--accent-soft); color: var(--accent); padding: 2px 10px; border-radius: 999px; margin-top: 8px; }
    .neta-foot { margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-size: 14px; color: var(--ink-soft); display: flex; justify-content: space-between; align-items: center; }
    .state-switch { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .state-switch a { padding: 8px 18px; border-radius: 999px; white-space: nowrap; text-decoration: none; font-weight: 700; font-size: 14px; border: 1px solid rgba(255,255,255,.3); color: #cbd5e1; }
    .state-switch a.active { background: #fbbf24; color: #1b2a41; border-color: #fbbf24; }
    @media (max-width: 720px) { .hero h1 { font-size: 28px; } }
  </style>

  <section class="hero">
    <div class="wrap">
      <div class="state-switch">
        <a href="/">Maharashtra</a>
        <a href="/gujarat/">Gujarat</a>
        <a href="/rajasthan/">Rajasthan</a>
        <a href="/uttar-pradesh/">Uttar Pradesh</a>
        <a href="/delhi/">Delhi</a>
        <a href="/bihar/">Bihar</a>
        <a href="/assam/" class="active">Assam</a>
      </div>
      <h1 style="margin-top:16px">Assam ke neta — <span>kaam ka hisaab</span></h1>
      <p>126 Vidhan Sabha MLA, 14 Lok Sabha MP aur 7 Rajya Sabha MP — sabke chunav halafname ke saath. Kaam ka satyaapit record jald joda jayega.</p>
      <div class="hero-stats">
        <div><strong>{mlas.length}</strong><span>MLA</span></div>
        <div><strong>{mps.length}</strong><span>Lok Sabha MP</span></div>
        <div><strong>{rsMps.length}</strong><span>Rajya Sabha MP</span></div>
        <div><strong>{districts.length}</strong><span>Jile</span></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <h2 class="section-title">Sansad — Lok Sabha MP <span>({mps.length})</span></h2>
    <div class="grid">
      {mps.map(n => (
        <a class="neta-card card" href={`/assam/neta/${n.slug}/`}>
          <div class="neta-top">
            <div class="avatar">{initials(n.name)}</div>
            <div>
              <h3>{n.name}</h3>
              <div class="neta-meta">{n.post} • {n.constituency}</div>
            </div>
          </div>
          <span class="party-pill">{n.partyShort}</span>
          <div class="neta-foot">
            <span>{n.works.length} verified kaam</span>
            <span>Profile dekhein →</span>
          </div>
        </a>
      ))}
    </div>

    <h2 class="section-title">Sansad — Rajya Sabha MP <span>({rsMps.length})</span></h2>
    <div class="grid">
      {rsMps.map(n => (
        <a class="neta-card card" href={`/assam/neta/${n.slug}/`}>
          <div class="neta-top">
            <div class="avatar">{initials(n.name)}</div>
            <div>
              <h3>{n.name}</h3>
              <div class="neta-meta">{n.post} • {n.constituency}</div>
            </div>
          </div>
          <span class="party-pill">{n.partyShort}</span>
          <div class="neta-foot">
            <span>{n.works.length} verified kaam</span>
            <span>Profile dekhein →</span>
          </div>
        </a>
      ))}
    </div>

    <h2 class="section-title">Vidhan Sabha — Jile ke anusaar <span>({mlas.length} MLA)</span></h2>
    {districts.map(([d, arr]) => (
      <section class="dist-group">
        <h3 class="dist-title"><a href={`/assam/jila/${districtSlug(d)}/`}>{d}</a> <span>({arr.length} seats)</span></h3>
        <div class="grid">
          {arr.map(n => (
            <a class="neta-card card" href={`/assam/neta/${n.slug}/`}>
              <div class="neta-top">
                <div class="avatar">{initials(n.name)}</div>
                <div>
                  <h3>{n.name}</h3>
                  <div class="neta-meta">{n.constituency}</div>
                </div>
              </div>
              <span class="party-pill">{n.partyShort}</span>
              <div class="neta-foot">
                <span>{n.works.length} verified kaam</span>
                <span>Profile dekhein →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
