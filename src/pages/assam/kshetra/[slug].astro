---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { assamConstsAll, assamNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return assamConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = assamConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = assamNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/assam" stateName="Assam" districtHref={kshetra.district ? `/assam/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
