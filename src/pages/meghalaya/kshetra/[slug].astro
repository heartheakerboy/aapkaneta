---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { meghalayaConstsAll, meghalayaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return meghalayaConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = meghalayaConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = meghalayaNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/meghalaya" stateName="Meghalaya" districtHref={kshetra.district ? `/meghalaya/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
