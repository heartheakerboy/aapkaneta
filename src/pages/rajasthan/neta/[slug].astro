---
import NetaProfile from '../../../components/NetaProfile.astro';
import { rajNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return rajNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = rajNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/rajasthan" stateName="Rajasthan" homeLabel="Rajasthan home" />
