---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { rajConstsAll, rajNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return rajConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = rajConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = rajNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/rajasthan" stateName="Rajasthan" districtHref={kshetra.district ? `/rajasthan/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}` : null} />
