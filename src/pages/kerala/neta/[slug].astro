---
import NetaProfile from '../../../components/NetaProfile.astro';
import { keralaNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return keralaNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = keralaNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/kerala" stateName="Kerala" homeLabel="Kerala home" />
