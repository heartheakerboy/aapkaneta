---
import NetaProfile from '../../../components/NetaProfile.astro';
import { westbengalNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return westbengalNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = westbengalNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/westbengal" stateName="West Bengal" homeLabel="West Bengal home" />
