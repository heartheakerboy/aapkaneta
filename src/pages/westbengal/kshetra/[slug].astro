---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { westbengalConstsAll, westbengalNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return westbengalConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = westbengalConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = westbengalNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/westbengal" stateName="West Bengal" districtHref={kshetra.district ? `/westbengal/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
