---
import NetaProfile from '../../../components/NetaProfile.astro';
import { jammuKashmirNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return jammuKashmirNetasAll.map(n => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const neta = jammuKashmirNetasAll.find(n => n.slug === slug);
if (!neta) throw new Error('Neta not found: ' + slug);
---

<NetaProfile neta={neta} base="/jammu-kashmir" stateName="Jammu & Kashmir" homeLabel="Jammu & Kashmir home" />
