---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { jammuKashmirConstsAll, jammuKashmirNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return jammuKashmirConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = jammuKashmirConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = jammuKashmirNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/jammu-kashmir" stateName="Jammu & Kashmir" districtHref={kshetra.district ? `/jammu-kashmir/jila/${kshetra.district.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/` : null} />
