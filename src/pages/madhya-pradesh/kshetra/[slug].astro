---
import KshetraDetail from '../../../components/KshetraDetail.astro';
import { mpStateConstsAll, mpStateNetasAll } from '../../../data/all';

export function getStaticPaths() {
  return mpStateConstsAll.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const kshetra = mpStateConstsAll.find(c => c.slug === slug);
if (!kshetra) throw new Error('Constituency not found: ' + slug);
const leaders = mpStateNetasAll.filter(n => n.tenures.some(t => t.constituencySlug === kshetra.slug));
---

<KshetraDetail kshetra={kshetra} leaders={leaders} base="/madhya-pradesh" stateName="Madhya Pradesh" districtHref={kshetra.district ? `/madhya-pradesh/jila/${kshetra.district.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}` : null} />
